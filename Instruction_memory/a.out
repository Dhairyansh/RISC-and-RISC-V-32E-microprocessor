#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x1b380ef0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1b393bd0 .scope module, "instruction_memory_tb" "instruction_memory_tb" 3 3;
 .timescale -9 -12;
P_0x1b393d60 .param/l "ADDR_WIDTH" 0 3 6, +C4<00000000000000000000000000001000>;
P_0x1b393da0 .param/l "DATA_WIDTH" 0 3 7, +C4<00000000000000000000000000010000>;
v0x1b3adf70_0 .net "instruction", 15 0, L_0x1b3ae390;  1 drivers
v0x1b3ae030_0 .var "pc", 7 0;
S_0x1b393e40 .scope module, "dut" "instruction_memory" 3 18, 4 1 0, S_0x1b393bd0;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "pc";
    .port_info 1 /OUTPUT 16 "instruction";
P_0x1b36d580 .param/l "ADDR_WIDTH" 0 4 2, +C4<00000000000000000000000000001000>;
P_0x1b36d5c0 .param/l "DATA_WIDTH" 0 4 3, +C4<00000000000000000000000000010000>;
P_0x1b36d600 .param/str "MEM_FILE" 0 4 4, "program.mem";
L_0x1b3ae390 .functor BUFZ 16, L_0x1b3ae100, C4<0000000000000000>, C4<0000000000000000>, C4<0000000000000000>;
v0x1b3ad970_0 .net *"_ivl_0", 15 0, L_0x1b3ae100;  1 drivers
v0x1b3ada70_0 .net *"_ivl_2", 9 0, L_0x1b3ae200;  1 drivers
L_0x7fa86ece9018 .functor BUFT 1, C4<00>, C4<0>, C4<0>, C4<0>;
v0x1b3adb50_0 .net *"_ivl_5", 1 0, L_0x7fa86ece9018;  1 drivers
v0x1b3adc40_0 .net "instruction", 15 0, L_0x1b3ae390;  alias, 1 drivers
v0x1b3add20 .array "mem", 255 0, 15 0;
v0x1b3ade30_0 .net "pc", 7 0, v0x1b3ae030_0;  1 drivers
L_0x1b3ae100 .array/port v0x1b3add20, L_0x1b3ae200;
L_0x1b3ae200 .concat [ 8 2 0 0], v0x1b3ae030_0, L_0x7fa86ece9018;
S_0x1b36d6a0 .scope begin, "$unm_blk_1" "$unm_blk_1" 4 14, 4 14 0, S_0x1b393e40;
 .timescale 0 0;
v0x1b35bc50_0 .var/i "i", 31 0;
    .scope S_0x1b393e40;
T_0 ;
    %fork t_1, S_0x1b36d6a0;
    %jmp t_0;
    .scope S_0x1b36d6a0;
t_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x1b35bc50_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x1b35bc50_0;
    %cmpi/s 256, 0, 32;
    %jmp/0xz T_0.1, 5;
    %pushi/vec4 0, 0, 16;
    %ix/getv/s 4, v0x1b35bc50_0;
    %store/vec4a v0x1b3add20, 4, 0;
    %load/vec4 v0x1b35bc50_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1b35bc50_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %vpi_call/w 4 22 "$readmemh", P_0x1b36d600, v0x1b3add20 {0 0 0};
    %end;
    .scope S_0x1b393e40;
t_0 %join;
    %end;
    .thread T_0;
    .scope S_0x1b393bd0;
T_1 ;
    %vpi_call/w 3 26 "$dumpfile", "instruction_memory_tb.vcd" {0 0 0};
    %vpi_call/w 3 27 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1b393bd0 {0 0 0};
    %vpi_call/w 3 29 "$display", "==================================================" {0 0 0};
    %vpi_call/w 3 30 "$display", "    TESTBENCH: Instruction Memory Verification    " {0 0 0};
    %vpi_call/w 3 31 "$display", "==================================================" {0 0 0};
    %vpi_call/w 3 32 "$display", "PC Address | Fetched Instruction Code" {0 0 0};
    %vpi_call/w 3 33 "$display", "-----------|--------------------------" {0 0 0};
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x1b3ae030_0, 0, 8;
    %delay 10000, 0;
    %vpi_call/w 3 38 "$display", "   0x%02h    |          0x%04h", v0x1b3ae030_0, v0x1b3adf70_0 {0 0 0};
    %pushi/vec4 1, 0, 8;
    %store/vec4 v0x1b3ae030_0, 0, 8;
    %delay 10000, 0;
    %vpi_call/w 3 43 "$display", "   0x%02h    |          0x%04h", v0x1b3ae030_0, v0x1b3adf70_0 {0 0 0};
    %pushi/vec4 2, 0, 8;
    %store/vec4 v0x1b3ae030_0, 0, 8;
    %delay 10000, 0;
    %vpi_call/w 3 48 "$display", "   0x%02h    |          0x%04h", v0x1b3ae030_0, v0x1b3adf70_0 {0 0 0};
    %pushi/vec4 3, 0, 8;
    %store/vec4 v0x1b3ae030_0, 0, 8;
    %delay 10000, 0;
    %vpi_call/w 3 53 "$display", "   0x%02h    |          0x%04h", v0x1b3ae030_0, v0x1b3adf70_0 {0 0 0};
    %pushi/vec4 4, 0, 8;
    %store/vec4 v0x1b3ae030_0, 0, 8;
    %delay 10000, 0;
    %vpi_call/w 3 58 "$display", "   0x%02h    |          0x%04h", v0x1b3ae030_0, v0x1b3adf70_0 {0 0 0};
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x1b3ae030_0, 0, 8;
    %delay 10000, 0;
    %vpi_call/w 3 63 "$display", "   0x%02h    |          0x%04h (Uninitialized address)", v0x1b3ae030_0, v0x1b3adf70_0 {0 0 0};
    %vpi_call/w 3 65 "$display", "==================================================" {0 0 0};
    %vpi_call/w 3 66 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";
